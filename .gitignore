# Dependencies
node_modules/

# Local secrets and environment overrides
.env
.env.*
!.env.example

# Runtime workspace data (keep the directory, ignore its contents)
terminal-workspace/*
!terminal-workspace/.gitkeep

# Codex and local agent state
.codex/
.superpowers/

# Project documentation kept locally and excluded from the repository
docs/

# Logs, process files, and temporary output
*.log
*.pid
*.tmp
*.temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
dist/
build/
tmp/
temp/

# Operating system and editor metadata
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
